# =============================================
# HARMONI BACKEND — Variáveis de Ambiente
# Copie este arquivo para .env e preencha
# =============================================

# Servidor
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=seu_jwt_secret_aqui_minimo_32_chars
JWT_EXPIRES_IN=7d

# PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/harmoni_db

# Abacus AI
ABACUS_API_KEY=sua_api_key_do_abacus
ABACUS_DEPLOYMENT_ID=seu_deployment_id

# Stripe (billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Preços Stripe (IDs dos products/prices)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5500

# Email (opcional — para convites)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASS=senha_de_app
